# Copiá este archivo como .env (o cargá la variable en Vercel) para habilitar
# "Continuar con Google" en el login.
# Se crea en Google Cloud Console → APIs y servicios → Credenciales →
# ID de cliente de OAuth (tipo "Aplicación web").
VITE_GOOGLE_CLIENT_ID=

# Problemas y presupuestos: mientras el backend no tenga las rutas de
# CONTRATO_PROBLEMAS.md, se guardan en el navegador ("modo local").
# Cuando estén listas, poné true para usar el backend.
VITE_PROBLEMAS_BACKEND=
